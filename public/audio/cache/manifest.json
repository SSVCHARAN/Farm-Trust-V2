{
  "be3f67c1b01debb8": {
    "text": "సరే, టమాటాల ధర కిలోకి 35 రూపాయలు చేశాను.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/be3f67c1b01debb8.mp3"
  },
  "0ffafaa4b29ba4b4": {
    "text": "మీకు రెండు పెండింగ్ ఆర్డర్లు ఉన్నాయి.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/0ffafaa4b29ba4b4.mp3"
  },
  "90f4dc93738d3ee8": {
    "text": "మీ దగ్గర 20 కిలోల టమాటాలు ఉన్నాయి.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/90f4dc93738d3ee8.mp3"
  },
  "c91212f4dc5cc878": {
    "text": "టమాటాల ధర 35 రూపాయలు చేయనా?",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/c91212f4dc5cc878.mp3"
  },
  "1c84bbfc56256037": {
    "text": "ఈ వారం మీరు మొత్తం 2,450 రూపాయల అమ్మకాలు చేశారు.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/1c84bbfc56256037.mp3"
  },
  "61d6f6835e4f8103": {
    "text": "టమాటాల ధర ₹35/kg కి మార్చాను.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/61d6f6835e4f8103.mp3"
  },
  "354e96a4f017d275": {
    "text": "నాటు టమాటాలు ధరను ₹35/kgగా మార్చమంటారా?",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/354e96a4f017d275.mp3"
  },
  "f047327056c4e5d7": {
    "text": "మీకు 1 పెండింగ్ ఆర్డర్ ఉంది: #FT-1024.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/f047327056c4e5d7.mp3"
  },
  "7cfa30ab416c60db": {
    "text": "మీకు ఒక పెండింగ్ ఆర్డర్ ఉంది: #FT-1024.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/7cfa30ab416c60db.mp3"
  },
  "56f227cca19294a3": {
    "text": "మీకు ఒక పెండింగ్ ఆర్డర్ ఉంది.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/56f227cca19294a3.mp3"
  },
  "2a590fb95090cf79": {
    "text": "ప్రస్తుతం పెండింగ్‌లో ఎటువంటి ఆర్డర్లు లేవు. అన్ని ఆర్డర్లు ప్రాసెస్ చేయబడ్డాయి!",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/2a590fb95090cf79.mp3"
  },
  "bc40c8560b3b3e73": {
    "text": "అనన్య శర్మ గారి ఆర్డర్ సిద్ధమైంది.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/bc40c8560b3b3e73.mp3"
  },
  "055b690ea7d36ec9": {
    "text": "నమస్కారం! నేను ఫార్మ్ ట్రస్ట్ సహాయకుడిని. మీకు ఎలా సహాయపడగలను?",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/055b690ea7d36ec9.mp3"
  },
  "271b64feffa3a345": {
    "text": "మాట సరిగ్గా వినపడలేదు. దయచేసి మైక్ నొక్కి మళ్ళీ మాట్లాడండి.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/271b64feffa3a345.mp3"
  },
  "d6d1e82f883859af": {
    "text": "సరే, చర్య రద్దు చేయబడింది.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/d6d1e82f883859af.mp3"
  },
  "0516bf6753eaef30": {
    "text": "సరే, ఆఫర్ పంపించాను.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/0516bf6753eaef30.mp3"
  },
  "7c868304091995b1": {
    "text": "Sure, I have updated the tomato price to 35 rupees per kg.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/7c868304091995b1.mp3"
  },
  "6a22ec387f3b30a3": {
    "text": "Change tomato price to 35 rupees per kg?",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/6a22ec387f3b30a3.mp3"
  },
  "d8041cdd3ea7d581": {
    "text": "You have 2 pending orders.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/d8041cdd3ea7d581.mp3"
  },
  "7c577b258bea0cad": {
    "text": "You have 1 pending order from Ananya Sharma.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/7c577b258bea0cad.mp3"
  },
  "a09b97d7c30de82b": {
    "text": "You have 20 kg of fresh tomatoes in stock.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/a09b97d7c30de82b.mp3"
  },
  "81655f52a3947a06": {
    "text": "This week you had total sales of 2,450 rupees.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/81655f52a3947a06.mp3"
  },
  "83211828b77df0fa": {
    "text": "Namaste! I am your Farm Trust assistant. How can I help you today?",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/83211828b77df0fa.mp3"
  },
  "5a48df3e42b942a9": {
    "text": "Sorry, I did not catch that. Please tap the mic and speak again.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/5a48df3e42b942a9.mp3"
  },
  "fe5909b47bc99d0e": {
    "text": "Okay, action cancelled.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/fe5909b47bc99d0e.mp3"
  },
  "farmer_guidance_en": {
    "text": "Namaste Ravi Kumar! You can say: Show pending orders, Change tomato price to 35, Set tomato stock to 20 kg, or Accept Ananya's order.",
    "lang": "en-IN",
    "voice": "en-IN-NeerjaExpressiveNeural",
    "url": "/audio/cache/farmer_guidance_en.mp3"
  },
  "farmer_guidance_te": {
    "text": "నమస్కారం! మీరు కొత్త ఆర్డర్లు చెప్పు, టమాటాల ధర 35 చేయి, 20 కిలోల స్టాక్ ఉంది, లేదా అనన్య ఆర్డర్ అంగీకరించు అని మాట్లాడవచ్చు.",
    "lang": "te-IN",
    "voice": "te-IN-ShrutiNeural",
    "url": "/audio/cache/farmer_guidance_te.mp3"
  }
}